{
  "$schema_name": "LeadSpeed Respond SKU #1 — Google Sheet schema",
  "version": "IA8",
  "timezone_default": "America/Chicago",
  "tabs": {
    "Config": {
      "description": "Runtime key/value settings. One row per key.",
      "primary_key": "key",
      "columns": [
        { "name": "key", "type": "string", "required": true },
        { "name": "value", "type": "string", "required": true },
        { "name": "notes", "type": "string", "required": false }
      ],
      "keys": {
        "business_name": { "type": "string", "default": null, "meaning": "Business display name for SMS merge" },
        "owner_phone": { "type": "e164", "default": null, "meaning": "Owner mobile for alerts" },
        "tech_phone": { "type": "e164", "default": null, "meaning": "Tech/on-call mobile" },
        "alert_tech": { "type": "boolean", "default": true, "enum": ["TRUE", "FALSE"], "meaning": "Also SMS tech on Instant" },
        "twilio_from_number": { "type": "e164", "default": null, "meaning": "Twilio From number" },
        "timezone": { "type": "iana_tz", "default": "America/Chicago", "meaning": "Quiet hours + schedule TZ" },
        "quiet_hours_start": { "type": "hhmm", "default": "08:00", "meaning": "Inclusive local start" },
        "quiet_hours_end": { "type": "hhmm", "default": "20:00", "meaning": "Exclusive local end; roll forward" },
        "touch1_delay_minutes": { "type": "integer", "default": 30, "meaning": "Delay Instant → Touch1" },
        "touch2_delay_hours": { "type": "integer", "default": 24, "meaning": "Delay Instant → Touch2" },
        "touch3_delay_hours": { "type": "integer", "default": 72, "meaning": "Delay Instant → Touch3" },
        "dedup_window_minutes": { "type": "integer", "default": 120, "meaning": "Suppress duplicate Instant same phone" },
        "system_paused": { "type": "boolean", "default": false, "enum": ["TRUE", "FALSE"], "meaning": "Blocks outbound Instant and touches" },
        "jobber_enabled": { "type": "boolean", "default": false, "enum": ["TRUE", "FALSE"], "meaning": "Optional Jobber soft-fail adapter" },
        "hcp_enabled": { "type": "boolean", "default": false, "enum": ["TRUE", "FALSE"], "meaning": "Optional HCP soft-fail adapter" }
      }
    },
    "Lead_Log": {
      "description": "One row per lead intake attempt.",
      "primary_key": "lead_id",
      "columns": [
        { "name": "lead_id", "type": "string", "required": true, "example": "LEAD-20260920-A1B2" },
        { "name": "created_at", "type": "datetime_iso8601", "required": true },
        { "name": "source", "type": "enum", "required": true, "enum": ["missed_call", "web_form", "manual_test"] },
        { "name": "caller_phone", "type": "e164", "required": true },
        { "name": "caller_name", "type": "string", "required": false },
        { "name": "form_message", "type": "string", "required": false },
        { "name": "service_interest", "type": "string", "required": false },
        { "name": "status", "type": "enum", "required": true, "enum": ["New", "Texted", "FollowUp", "Replied", "Won", "Lost", "OptOut", "Error"], "default": "New" },
        { "name": "instant_sms_sid", "type": "string", "required": false, "meaning": "Twilio MessageSid for Instant" },
        { "name": "instant_sms_at", "type": "datetime_iso8601", "required": false },
        { "name": "alert_sms_sid", "type": "string", "required": false },
        { "name": "last_touch", "type": "integer", "required": false, "enum": [0, 1, 2, 3], "meaning": "0=Instant only; 1–3=last follow-up sent" },
        { "name": "opt_out", "type": "boolean", "required": true, "default": false },
        { "name": "error_detail", "type": "string", "required": false },
        { "name": "external_id", "type": "string", "required": false, "meaning": "Jobber/HCP id if adapter succeeds" }
      ]
    },
    "Follow_ups": {
      "description": "Scheduled touches 1–3 per lead.",
      "primary_key": "followup_id",
      "columns": [
        { "name": "followup_id", "type": "string", "required": true },
        { "name": "lead_id", "type": "string", "required": true, "fk": "Lead_Log.lead_id" },
        { "name": "touch", "type": "enum", "required": true, "enum": [1, 2, 3] },
        { "name": "send_at", "type": "datetime_iso8601", "required": true },
        { "name": "status", "type": "enum", "required": true, "enum": ["Pending", "Sent", "Skipped", "Canceled"], "default": "Pending" },
        { "name": "sms_sid", "type": "string", "required": false },
        { "name": "sent_at", "type": "datetime_iso8601", "required": false },
        { "name": "skip_reason", "type": "string", "required": false, "examples": ["opt_out", "replied", "won", "lost", "system_paused", "dedup", "quiet_hours_reschedule"] }
      ]
    },
    "Message_Slots": {
      "description": "Writer-owned SMS bodies. Implementer must not invent final copy.",
      "primary_key": "slot_key",
      "columns": [
        { "name": "slot_key", "type": "enum", "required": true, "enum": ["instant_textback", "alert_owner", "alert_tech", "touch_1", "touch_2", "touch_3", "opt_out_confirm", "help_reply"] },
        { "name": "body", "type": "string", "required": true, "meaning": "May contain {{merge}} tokens; Writer fills [WRITER:…] placeholders" },
        { "name": "merge_vars_used", "type": "string", "required": false },
        { "name": "notes", "type": "string", "required": false }
      ]
    },
    "QA_Log": {
      "description": "Evidence for QA gates A1–A12.",
      "primary_key": "test_id",
      "columns": [
        { "name": "test_id", "type": "string", "required": true },
        { "name": "ran_at", "type": "datetime_iso8601", "required": true },
        { "name": "scenario", "type": "string", "required": true },
        { "name": "pass_fail", "type": "enum", "required": true, "enum": ["PASS", "FAIL", "BLOCKED"] },
        { "name": "notes", "type": "string", "required": false }
      ]
    }
  },
  "status_transitions": {
    "Lead_Log.status": {
      "New": ["Texted", "Error", "OptOut"],
      "Texted": ["FollowUp", "Replied", "Won", "Lost", "OptOut", "Error"],
      "FollowUp": ["FollowUp", "Replied", "Won", "Lost", "OptOut", "Error"],
      "Replied": ["Won", "Lost", "OptOut"],
      "Won": [],
      "Lost": [],
      "OptOut": [],
      "Error": ["New", "Texted"]
    }
  }
}
